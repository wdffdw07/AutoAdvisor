# Copy this file to .env and fill in real values.

# Preferred path for the current baseline.
GLM_API_KEY=your_glm_api_key_here

# Optional OpenAI-compatible path.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Runtime model used by main.py + llm_agent.py.
LLM_MODEL=glm-4-flash

# Local server port.
SERVER_PORT=8000
